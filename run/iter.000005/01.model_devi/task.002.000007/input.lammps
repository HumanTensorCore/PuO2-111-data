variable        NSTEPS          equal 20000
variable        TEMP            equal 430
variable        PRES            equal 6

units           metal
boundary        p p p
atom_style      atomic

neighbor        1.0 bin
read_data       conf.lmp
box             tilt large
change_box      all triclinic

mass            1 239.000000
mass            2 16.000000
mass            3 2.000000

pair_style      deepmd ../graph.000.pth ../graph.001.pth ../graph.002.pth ../graph.003.pth  out_freq 10 out_file model_devi.out 
pair_coeff      * *

thermo_style    custom step temp pe ke etotal press vol lx ly lz xy xz yz
thermo          10
dump            dpgen_dump all custom 10    all.lammpstrj id type x y z

velocity        all create ${TEMP} 123456 dist gaussian
fix             1 all temp/csvr ${TEMP} ${TEMP} 0.1 54321
fix             2 all nve

timestep        0.001000
# 这里的占位符必须保持 ${nsteps}
run             ${NSTEPS}
