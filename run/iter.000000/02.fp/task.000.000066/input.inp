#Generated by Multiwfn
&GLOBAL
  PROJECT fp
  PRINT_LEVEL MEDIUM
  RUN_TYPE ENERGY_FORCE
#  PREFERRED_DIAG_LIBRARY SL
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &SUBSYS
    &CELL
A  11.3342  0.      0.    
B  -5.6671      9.81570513  0.        
C   0.      0.     30.7967
      PERIODIC XYZ #Direction(s) of applied PBC (geometry aspect)
    &END CELL 
    &COORD
      @INCLUDE coord.xyz 
    &END COORD
    &KIND O
       ELEMENT O
      BASIS_SET DZVP-MOLOPT-SR-GTH-q6
      POTENTIAL GTH-PBE
      #&DFT_PLUS_U
      #  L 1 #Quantum number of angular momentum the atomic orbitals to +U. 0=s, 1=p, 2=d, 3=f
      #  U_MINUS_J [eV] 2.0 #Effective on-site Coulomb interaction parameter U(eff) = U - J
      #&END DFT_PLUS_U
    &END KIND
    &KIND H
       ELEMENT H
      BASIS_SET DZVP-MOLOPT-SR-GTH-q1
      POTENTIAL GTH-PBE
      #&DFT_PLUS_U
      #  L 1 #Quantum number of angular momentum the atomic orbitals to +U. 0=s, 1=p, 2=d, 3=f
      #  U_MINUS_J [eV] 2.0 #Effective on-site Coulomb interaction parameter U(eff) = U - J
      #&END DFT_PLUS_U
    &END KIND
    &KIND Pu
      ELEMENT Pu
      BASIS_SET DZVP-MOLOPT-GTH-q16
      POTENTIAL GTH-PBE-q16
      &DFT_PLUS_U
        L 3 #Quantum number of angular momentum the atomic orbitals to +U. 0=s, 1=p, 2=d, 3=f
        U_MINUS_J [eV] 3.0 #Effective on-site Coulomb interaction parameter U(eff) = U - J
      &END DFT_PLUS_U
    &END KIND
  &END SUBSYS

  &DFT
    BASIS_SET_FILE_NAME  BASIS_ZYZ
    POTENTIAL_FILE_NAME  POTENTIALS_ZYZ
#   WFN_RESTART_FILE_NAME 96-RESTART.wfn
    CHARGE    0 #Net charge
    MULTIPLICITY    1 #Spin multiplicity
    PLUS_U_METHOD MULLIKEN
#    &KPOINTS
#      SCHEME MONKHORST-PACK  7  7  7
#    &END KPOINTS
    &QS
      EPS_DEFAULT 1.0E-12 #Set all EPS_xxx to values such that the energy will be correct up to this value
      EXTRAPOLATION USE_PREV_P #Use converged density matrix of last geometry as initial guess
    &END QS
    &POISSON
      PERIODIC XYZ #Direction(s) of PBC for calculating electrostatics
      PSOLVER PERIODIC #The way to solve Poisson equation
    &END POISSON
    &XC
      &XC_FUNCTIONAL PBE
#        &PBE
#          PARAMETRIZATION PBESOL
#        &END PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          PARAMETER_FILE_NAME dftd3.dat
          TYPE DFTD3(BJ)
          REFERENCE_FUNCTIONAL PBE
          #CALCULATE_C9_TERM T #Calculate C9-related three-body term, more accurate for large system
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
    &MGRID
      CUTOFF  400
      REL_CUTOFF  50
    &END MGRID
    &SCF
      MAX_SCF 50 #Should be set to a small value (e.g. 20) if enabling outer SCF
      IGNORE_CONVERGENCE_FAILURE
      EPS_SCF 1.0E-06 #Convergence threshold of density matrix during SCF
#     SCF_GUESS RESTART #Use wavefunction from WFN_RESTART_FILE_NAME file as initial guess
#      &DIAGONALIZATION
#        ALGORITHM STANDARD #Algorithm for diagonalization
#      &END DIAGONALIZATION
       &OT
         PRECONDITIONER FULL_ALL #Usually best but expensive for large system. Cheaper: FULL_SINGLE_INVERSE and FULL_KINETIC
         MINIMIZER CG #DIIS #CG is worth to consider in difficult cases
         LINESEARCH 2PNT #1D line search algorithm for CG. 2PNT is default, 3PNT is better but more costly. GOLD is best but very expensive
         ALGORITHM STRICT #Algorithm of OT. Can be STRICT (default) or IRAC
       &END OT
       &OUTER_SCF
        MAX_SCF 5 #Maximum number of steps of outer SCF
        EPS_SCF 1.0E-06 #Convergence threshold of outer SCF
      &END OUTER_SCF
      &PRINT
        &RESTART #Note: Use "&RESTART OFF" can prevent generating .wfn file
          BACKUP_COPIES 0 #Maximum number of backup copies of wfn file. 0 means never
        &END RESTART
      &END PRINT
    &END SCF
#    SURFACE_DIPOLE_CORRECTION T
#    SURF_DIP_DIR Z
  &END DFT
  &PRINT
    &FORCES ON
    &END FORCES
    &STRESS_TENSOR ON #Print stress tensor
    &END STRESS_TENSOR
  &END PRINT
  STRESS_TENSOR ANALYTICAL
&END FORCE_EVAL

